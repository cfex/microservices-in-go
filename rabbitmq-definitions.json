{
  "rabbit_version": "3.12.0",
  "rabbitmq_version": "3.12.0",
  "management_version": "3.12.0",
  "users": [
    {
      "name": "admin",
      "password": "admin",
      "tags": ["administrator"],
      "limits": {}
    }
  ],
  "vhosts": [
    {
      "name": "/microservices"
    }
  ],
  "permissions": [
    {
      "user": "admin",
      "vhost": "/microservices",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "email.exchange",
      "vhost": "/microservices",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "user.exchange",
      "vhost": "/microservices",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "project.exchange",
      "vhost": "/microservices",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "email.queue",
      "vhost": "/microservices",
      "durable": true,
      "auto_delete": false,
      "exclusive": false,
      "arguments": {
        "x-message-ttl": 86400000
      }
    }
  ],
  "bindings": [
    {
      "source": "email.exchange",
      "destination": "email.queue",
      "destination_type": "queue",
      "routing_key": "email.*",
      "vhost": "/microservices",
      "arguments": {}
    }
  ]
}
